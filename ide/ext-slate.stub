<?php
// php-baremetal/ext-slate 1.2.0 — IDE helper, not loaded at runtime.

namespace Baremetal\Slate {
    /**
     * Draws scenes on a display panel and keeps them up to date: only what changed is composed again, band by
     * band, at the panel's pace. One Slate runs at a time; it takes the panel from the display object (its
     * drawing methods throw until the Slate goes) and gives it back when it is destroyed.
     *
     * Changes to elements are collected while PHP runs and handed to the compositor when the script returns to
     * the event loop (after each listener, or after each loop()), when show() is called, and by commit(): the
     * changes of one listener appear together, in the same frame.
     */
    final class Slate
    {
        /**
         * How many scenes left keep their caches (cached groups, shadows, blurs) for a return to them; 0: a scene
         * left drops them, as in 1.1. Past it, the oldest scene left drops them at once (also when it is lowered).
         * The caches stay in Slate's cache budget in PSRAM: when the shown scene needs room there, the scenes left
         * drop theirs first, oldest first.
         *
         * @throws \ValueError When negative ("keepScenes must be 0 or more"); the old value stays.
         */
        public int $keepScenes = 2;

        /**
         * A limit in KB for the caches of the scenes left; past it the oldest drops them at once (0: none is kept).
         * null: only Slate's cache budget limits them.
         *
         * @throws \ValueError When negative ("keptBudget must be 0 or more"); the old value stays.
         */
        public ?int $keptBudget = null;

        /**
         * Takes the panel of $display and starts the compositor; with $touch, Slate routes its touch events to
         * the elements of the scene shown (see Touch) and the rest to Scene::onTouch().
         *
         * @param \Baremetal\Output\Display $display A display whose driver has the band path.
         * @param \Baremetal\Input\Touch|null $touch The touch device of the same screen, or null.
         * @throws \LogicException When another Slate runs, the panel has no band path ("Slate: <Class> has no band
         *     path") or another renderer holds it.
         * @throws \RuntimeException When the compositor cannot start (memory for its buffers, or its task).
         */
        public function __construct(\Baremetal\Output\Display $display, ?\Baremetal\Input\Touch $touch = null) {}

        /**
         * A Slate on the board's own display (and touch screen, when the board has one): among the loaded driver
         * classes, the one display driver (and touch driver) with a static onboard() method is used.
         *
         * @throws \LogicException When the board has no display block, or no driver or several drivers with
         *     onboard() are loaded: build it with new Slate($display, $touch) then.
         */
        public static function onboard(): Slate {}

        /**
         * Shows a scene. build() runs the first time the scene is shown.
         *
         * Without $t the change is instant: onLeave() of the scene shown until now, then onEnter() of the new one.
         *
         * With $t the new scene slides or fades in: its onEnter() runs at once (its elements are ready and its
         * tweens start), and at the end onLeave() of the old scene runs and TransitionDone is raised. Meanwhile
         * scene() is the new scene, both scenes' tweens run, and the touch reaches neither. From no scene shown
         * (the first show()) the new scene comes in over the black background, with no TransitionDone.
         *
         * show() of the scene shown (also the one a transition goes to) does nothing. show() during a transition
         * ends it first: onLeave() of the scene it leaves runs now (its TransitionDone follows), then the new
         * change starts from the scene it went to, whole.
         *
         * The change is sent to the compositor at once.
         *
         * @throws \RuntimeException When the compositor has failed (the panel stopped answering) or is out of
         *     memory.
         */
        public function show(Scene $s, ?Transition $t = null): void {}

        /**
         * The scene shown now (during a transition: the scene it goes to), or null before the first show().
         */
        public function scene(): ?Scene {}

        /**
         * Sends the changes made so far to the compositor now. Needed only by a script that never returns to an
         * event loop (a script without listeners or loop()).
         *
         * @throws \RuntimeException When the compositor has failed.
         */
        public function commit(): void {}
    }

    /**
     * A screen of the application. Extend it: add the components in build(), react in onEnter(), onLeave(),
     * onTouch() and in your own methods and listeners. A plain Scene works too: (new Scene())->add(...).
     */
    class Scene
    {
        /**
         * Whether the scene's caches stay when it is left, for a quick return (within Slate::$keepScenes and
         * Slate::$keptBudget). Set it to false in a scene shown once (a splash): its caches go when it is left.
         */
        protected bool $keepCache = true;

        /**
         * Adds elements on top of the scene's elements (the last one added is drawn on top).
         *
         * @throws \LogicException When an element already belongs to a group or a scene.
         */
        public function add(Element ...$e): static {}

        /**
         * Takes elements out of the scene; they stay usable and can be added again.
         */
        public function remove(Element ...$e): static {}

        /**
         * Builds the scene's components; called once, before the scene is shown the first time.
         */
        protected function build(): void {}

        /**
         * Called each time the scene is shown (with a transition: when it starts).
         */
        public function onEnter(): void {}

        /**
         * Called when another scene replaces this one (with a transition: when it ends, or when a show() during it
         * ends it).
         */
        public function onLeave(): void {}

        /**
         * Called with the raw touch events (Pressed, Moved, Released, Gesture) of the Slate's touch device while this
         * scene is shown, for the touches whose Pressed hit no touchable element (the background; a Scroll is
         * touchable by default; a scene without touchable elements gets them all), the Gesture of such a touch
         * included (also when it comes after the Released). Not during a transition.
         */
        public function onTouch(\Baremetal\Input\TouchEvent $e): void {}
    }

    /**
     * The base of the elements. Properties are read and written as usual (not by reference); a write of a wrong
     * value throws \ValueError naming the property and its limit, and the old value stays.
     *
     * Colors: 0xRRGGBB is opaque, 0xAARRGGBB with AA from 01 to FF translucent; 0x00RRGGBB is opaque too, so a
     * transparent fill or border is null. A component of your own extends Group, not Element.
     */
    abstract class Element
    {
        /** Horizontal position, relative to the parent group (pixels; fractions are drawn anti-aliased). */
        public int|float $x;

        /** Vertical position, relative to the parent group. */
        public int|float $y;

        /** false hides the element (and, for a group, its children). */
        public bool $visible;

        /** 0 (transparent) to 1 (opaque); a group's opacity applies to the group as a whole. */
        public float $opacity;

        /**
         * Whether the element takes touches: the finger on its area (its box on the screen, for a group with its
         * children, grown by $hitPad, cut by the clip of its ancestors) gives it Press, Move, Release, Tap, Hold and
         * Cancel (the methods onPress()..onCancel() and the callbacks of on()). An element with a callback takes
         * touches also while this is false. Declare it `public bool $touchable = true;` in a component of your own.
         */
        public bool $touchable = false;

        /**
         * Pixels added to the touch area on every side, 0 to 64 (a small target made easier to hit). A default
         * of a subclass out of range is not checked: the nearest limit is used.
         *
         * @throws \ValueError When out of range ("Baremetal\Slate\<Class>::$hitPad must be between 0 and 64").
         */
        public int $hitPad = 0;

        /**
         * Milliseconds the finger stays down (within 8 px) before Hold, 0 to 10000; 0: never a Hold. A default
         * of a subclass out of range is not checked: the nearest limit is used.
         *
         * @throws \ValueError When out of range ("Baremetal\Slate\<Class>::$holdMs must be between 0 and 10000").
         */
        public int $holdMs = 500;

        /**
         * Sets several properties at once, by name: $el->set(x: 10, opacity: 0.5).
         *
         * @throws \ValueError When a value is out of range.
         * @throws \Error When a name is not a property.
         */
        public function set(mixed ...$props): static {}

        /**
         * Animates properties from their values on the screen to the ones given, in the compositor, at the
         * panel's pace: ['x' => 200, 'opacity' => 0.5]. The properties read their final values at once. All of them
         * share the time and the curve, and make one Tween; TweenDone follows when it ends by itself. A new
         * animate() of a property that is already moving takes it over from where it is.
         *
         * Animatable: x, y and opacity of every element; Group w, h, blur; RoundRect w, h, radius, border, fill,
         * borderColor; Circle r, border, fill, borderColor; Arc r, from, to, width, color; Line x1, y1, width,
         * color; Text color. Colours move channel by channel; gradients and null (no fill, no border) are not
         * animated.
         *
         * Like every tween of an element that is not shown, the tween of an element Slate has not drawn yet (made
         * in build(), or before add()) waits, and starts when the element is shown.
         *
         * @param array<string, int|float|null> $props Property => final value, as a write of the property takes it.
         * @param int $ms One run, in milliseconds (at least 1).
         * @param int $delay Milliseconds before the first run.
         * @param int $repeat Runs after the first; -1: forever (never done).
         * @param bool $yoyo The repeats go back and forth (an odd repeat ends where it started).
         * @throws \ValueError When a property is not animatable ("Baremetal\Slate\<Class>::$<name> cannot be
         *     animated"), is a gradient or null now or as the target ("... cannot be animated: it is a gradient",
         *     "... cannot be animated: it is null"), a value is
         *     out of range, $props is empty, ms < 1 ("ms must be at least 1"), delay < 0 or repeat < -1 ("repeat must
         *     be -1 or more"). Nothing changes then.
         */
        public function animate(array $props, int $ms = 300, Ease $ease = Ease::OutCubic, int $delay = 0,
                                int $repeat = 0, bool $yoyo = false): Tween {}

        /**
         * From now on, every write of these properties slides to its value in $ms instead of jumping (from where
         * the property is on the screen). ease([]) makes them jump again. No TweenDone for these moves.
         *
         * @param list<string> $props Names of animatable properties (see animate()).
         * @throws \ValueError When a property is not animatable, or ms < 1.
         */
        public function ease(array $props, int $ms = 300, Ease $ease = Ease::OutCubic): static {}

        /**
         * Sets the callback of one kind of touch (one per kind: a new one replaces the old one). The element takes
         * touches while it has a callback, also with $touchable false. With a method and a callback, the method runs
         * first.
         *
         * @param \Closure(Touch): void $fn
         */
        public function on(TouchType $type, \Closure $fn): static {}

        /**
         * Removes the callback of one kind of touch (nothing when there is none).
         */
        public function off(TouchType $type): static {}

        /**
         * The finger came down on the element: from now on the touch is the element's (it captures it). Overriding
         * these methods does not make the element take touches: set $touchable (or a callback with on()) as well.
         */
        public function onPress(Touch $t): void {}

        /** The finger moved, anywhere on the screen. */
        public function onMove(Touch $t): void {}

        /** The finger came up, anywhere on the screen. */
        public function onRelease(Touch $t): void {}

        /**
         * After onRelease(), when the finger stayed within 8 px of the press, no Hold came and it came up on the area
         * (decided at the release: removing the element in onRelease() does not stop it).
         */
        public function onTap(Touch $t): void {}

        /** The finger stayed down $holdMs milliseconds without moving past 8 px (once; no Tap after it). */
        public function onHold(Touch $t): void {}

        /**
         * The touch ended without Release or Tap: the element (or an ancestor) was removed or hidden, the element
         * stopped taking touches, another scene was shown or a transition started.
         */
        public function onCancel(Touch $t): void {}
    }

    /**
     * The kinds of a touch on an element.
     */
    enum TouchType
    {
        case Press;
        case Move;
        case Release;
        case Tap;
        case Hold;
        case Cancel;
    }

    /**
     * A touch on an element, given to its methods onPress()..onCancel() and to its callbacks.
     */
    final class Touch
    {
        public readonly TouchType $type;

        /** The element that has the touch. */
        public readonly Element $element;

        /** The finger on the screen, in pixels. */
        public readonly int $x;

        public readonly int $y;

        /** The finger from the element's (x, y) on the screen (with the positions of the Scrolls it is in). */
        public readonly int $localX;

        public readonly int $localY;

        /**
         * When, as \Baremetal\Event::$time: nanoseconds on the base of hrtime(true), an int where PHP integers are
         * 64-bit, a float where they are 32-bit. The $time of the touch event; for Hold the press time plus $holdMs;
         * for Cancel the time of the last event.
         */
        public readonly int|float $time;

        /** Made by Slate only. */
        private function __construct() {}
    }

    /**
     * @internal Slate's own: the Hold timer of a touch came due. Slate handles it; it has no use for a listener.
     */
    final class HoldDue extends \Baremetal\Event
    {
    }

    /**
     * A group of elements, whose positions are relative to the group's (x, y). With clip, the children are cut to
     * the box (0, 0, w, h); with cache, the group is kept as an image and redrawn only when something inside it
     * changes; blur (in pixels, as CSS blur) and shadow make it cached as well. Extend it to build a component of
     * your own.
     */
    class Group extends Element
    {
        /** The clip box's width (for clip). */
        public int|float $w;

        /** The clip box's height (for clip). */
        public int|float $h;

        /** Cut the children to the box (0, 0, w, h); needs w and h greater than 0. */
        public bool $clip;

        /** Keep the group as an image (in PSRAM) and redraw it only when its content changes. */
        public bool $cache;

        /** Blur of the group, in pixels (how far the softness reaches); 0: none. */
        public int $blur;

        /** A drop shadow of the group's content, or null. */
        public ?Shadow $shadow;

        /**
         * @throws \ValueError When a value is out of range, clip without a box, or blur > 0 when the blur effect
         *     is not built in.
         */
        public function __construct(int|float $x = 0, int|float $y = 0, int|float $w = 0, int|float $h = 0,
                                    float $opacity = 1.0, bool $clip = false, bool $cache = false, int $blur = 0,
                                    ?Shadow $shadow = null) {}

        /**
         * Adds elements on top of the group's children.
         *
         * @throws \LogicException When an element already belongs to a group, or would contain itself.
         */
        public function add(Element ...$e): static {}

        /**
         * Takes elements out of the group; they stay usable.
         */
        public function remove(Element ...$e): static {}
    }

    /**
     * A view (0, 0, w, h), always clipped, over its children, the content: they are placed in content coordinates
     * and drawn shifted by the scroll position. The finger drags the content (the scroll takes the touches by itself:
     * $touchable is true; touch() routes them by hand), a release flings it on with inertia, past an edge it
     * stretches and springs back, and it can snap to steps; bars show the position while it moves. The compositor
     * runs all of it at the pace of the panel; PHP is told when a motion ends (ScrollEnded). Extend it to build a
     * list of your own.
     *
     * $w and $h (inherited) are the view, 1..32767; $clip is always true (writing false throws \ValueError
     * "Baremetal\Slate\Scroll::$clip is always true"); $cache keeps the whole content as one image.
     */
    class Scroll extends Group
    {
        /**
         * The scroll takes the touches that hit it (its view, where no touchable child is on top) and, past 8 px on
         * an axis it can move, the ones of its touchable children (they get Cancel); a press while it moves stops it
         * (the element under the finger gets nothing). Nested scrolls: the innermost that can move that way. Those
         * touches no longer reach Scene::onTouch(). false: it takes none (route them by hand with touch()).
         */
        public bool $touchable = true;

        /** The content's width, 0..32767; 0: the box of the children from (0, 0), kept up to date. */
        public int $contentW;

        /** The content's height, 0..32767; 0: the box of the children from (0, 0), kept up to date. */
        public int $contentH;

        /** The axes the content moves on. */
        public ScrollAxis $axis;

        /** Past an edge the content stretches and springs back; false: it stops at the edge. */
        public bool $bounce;

        /**
         * Snap step on x in pixels (the content comes to rest on a multiple of it, or on the end),
         * 0..32767; 0: none.
         */
        public int $snapX;

        /** Snap step on y in pixels, 0..32767; 0: none. */
        public int $snapY;

        /**
         * At most this many snap steps per release, counted in the direction of the fling from the snap point at or
         * behind the release position (never back against the fling; under 20 px/s the nearest point), 0..32767;
         * 0: no limit. Per axis, only on an axis with a snap step: 1 makes a carousel move one card per fling,
         * however fast. Not animatable.
         */
        public int $snapMax;

        /** Bars that show the position while the content moves, then fade. */
        public bool $indicators;

        /**
         * The position on x: read, the one last drawn (after a write, the value written until it is drawn); written,
         * the content jumps there (kept within the limits, no error) and any motion stops.
         */
        public int|float $scrollX;

        /** The position on y (as $scrollX). */
        public int|float $scrollY;

        /**
         * @throws \ValueError When a value is out of range ("Baremetal\Slate\Scroll::$w must be between 1 and
         *     32767", "...::$snapY must be between 0 and 32767", ...).
         */
        public function __construct(int|float $x = 0, int|float $y = 0, int|float $w = 1, int|float $h = 1,
                                    ScrollAxis $axis = ScrollAxis::Both, bool $bounce = true, int $snapX = 0,
                                    int $snapY = 0, int $snapMax = 0, bool $indicators = true, int $contentW = 0,
                                    int $contentH = 0, float $opacity = 1.0, bool $cache = false) {}

        /**
         * Gives the scroll a touch event by hand (usually from Scene::onTouch(), for a scroll with $touchable false,
         * or for a touch that hit nothing). While the scroll has a touch of its own ($touchable), touch() does
         * nothing and returns false: no touch is fed twice. True when the touch belongs to the scroll:
         * a Moved past 8 px from the press (on the axis allowed; with Both, the distance) and the ones after it, the
         * Released that ends a drag (the content flings on); and a catch: a Pressed inside the view while the content
         * moves (it stops there), with every Moved and the Released of that touch (never a tap; a drag may still
         * start from it). False for a Pressed outside the view, a Pressed at rest, a Moved under 8 px and a Released
         * without a drag (a tap), a Gesture, and for a scroll that is not in the scene shown. The view is the part on
         * the screen (cut by the scrolls and clipping groups it is in). A touch that is the scroll's stays so to its
         * end, also when a write of the position, scrollTo(), a new set-up or leaving the screen ends its drag (from
         * then on nothing is sent for it).
         *
         * @throws \TypeError When $e is not a TouchEvent.
         */
        public function touch(\Baremetal\Input\TouchEvent $e): bool {}

        /**
         * Moves the content to ($x, $y), kept within the limits, in $ms milliseconds along $ease; the Tween ends with
         * its TweenDone and the scroll's ScrollEnded. $ms 0 (or a scroll not drawn yet): it jumps there, the Tween is
         * done at once. A press, a write of $scrollX/$scrollY or a change of $axis, $bounce or the snap steps stops
         * it (no TweenDone).
         *
         * @throws \ValueError When $x or $y is not finite ("Baremetal\Slate\Scroll::$scrollX must be a finite
         *     number"), $ms < 0 ("ms must be 0 or more") or past 2147483647.
         */
        public function scrollTo(int|float $x, int|float $y, int $ms = 300, Ease $ease = Ease::OutCubic): Tween {}
    }

    /**
     * The axes a Scroll moves on.
     */
    enum ScrollAxis
    {
        case Both;
        case Vertical;
        case Horizontal;
    }

    /**
     * The content of a Scroll came to rest after a release (inertia, snap, spring) or at the end of a scrollTo()
     * (which also gives its TweenDone). Once per motion; never while the finger holds the content.
     */
    final class ScrollEnded extends \Baremetal\Event
    {
        /** The scroll. */
        public readonly Scroll $scroll;

        /** Its position, in whole pixels. */
        public readonly int $x;

        public readonly int $y;
    }

    /**
     * A rectangle with rounded corners (radius 0: square corners), filled and optionally bordered.
     */
    final class RoundRect extends Element
    {
        public int|float $w;
        public int|float $h;

        /** Corner radius, at most half the shorter side. */
        public int|float $radius;

        /** 0xRRGGBB, 0xAARRGGBB, a gradient, or null (no fill). */
        public int|float|Gradient|null $fill;

        /** Border width, drawn inside the outline; 0: none. */
        public int|float $border;

        /** Border color, or null (no border). */
        public int|float|null $borderColor;

        /** A drop shadow, or null. */
        public ?Shadow $shadow;

        public function __construct(int|float $x, int|float $y, int|float $w, int|float $h, int|float $radius = 0,
                                    int|float|Gradient|null $fill = null, int|float $border = 0,
                                    int|float|null $borderColor = null, ?Shadow $shadow = null) {}
    }

    /**
     * A disc; $x and $y are its centre (the constructor's $cx and $cy).
     */
    final class Circle extends Element
    {
        public int|float $r;

        /** 0xRRGGBB, 0xAARRGGBB, a gradient, or null (no fill). */
        public int|float|Gradient|null $fill;

        public int|float $border;
        public int|float|null $borderColor;
        public ?Shadow $shadow;

        public function __construct(int|float $cx, int|float $cy, int|float $r, int|float|Gradient|null $fill = null,
                                    int|float $border = 0, int|float|null $borderColor = null,
                                    ?Shadow $shadow = null) {}
    }

    /**
     * A stroke along a circle, from $from to $to degrees (0 = 3 o'clock, clockwise); $x and $y are its centre.
     * For progress bars and gauges.
     */
    final class Arc extends Element
    {
        public int|float $r;
        public int|float $from;
        public int|float $to;

        /** Stroke width. */
        public int|float $width;

        /** 0xRRGGBB, 0xAARRGGBB or a gradient. */
        public int|float|Gradient $color;

        public Caps $caps;

        public function __construct(int|float $cx, int|float $cy, int|float $r, int|float $from, int|float $to,
                                    int|float $width, int|float|Gradient $color, Caps $caps = Caps::Round) {}
    }

    /**
     * A segment from ($x, $y) (the constructor's $x0, $y0) to ($x1, $y1), relative to the parent.
     */
    final class Line extends Element
    {
        public int|float $x1;
        public int|float $y1;
        public int|float $width;

        /** 0xRRGGBB or 0xAARRGGBB. */
        public int|float $color;

        public Caps $caps;

        public function __construct(int|float $x0, int|float $y0, int|float $x1, int|float $y1, int|float $width = 1,
                                    int|float $color = 0xFFFFFF, Caps $caps = Caps::Butt) {}
    }

    /**
     * One line of text in a font of the firmware; ($x, $y) is the top of the line, at its left end, centre or
     * right end depending on $align.
     */
    final class Text extends Element
    {
        public string $text;

        /** The name of a font of the firmware (extra.baremetal.fonts). */
        public string $font;

        /** 0xRRGGBB or 0xAARRGGBB. */
        public int|float $color;

        public Align $align;

        /** Cut the text to this many pixels (no ellipsis); 0: no limit. */
        public int $maxWidth;

        /**
         * @throws \ValueError When the font is not in the firmware.
         */
        public function __construct(int|float $x, int|float $y, string $text, string $font = 'default',
                                    int|float $color = 0xFFFFFF, Align $align = Align::Left, int $maxWidth = 0) {}
    }

    /**
     * Pixels of your own: draw with the primitives below (colors 0xRRGGBB), then call dirty() to show what
     * changed.
     */
    final class Canvas extends Element
    {
        /** Width in pixels (1 to 1024); a new size clears the canvas. */
        public int $w;

        /** Height in pixels (1 to 1024). */
        public int $h;

        public function __construct(int|float $x, int|float $y, int $w, int $h) {}

        /** Fills the canvas with one color. */
        public function clear(int $color = 0): void {}

        public function pixel(int $x, int $y, int $color): void {}

        public function line(int $x0, int $y0, int $x1, int $y1, int $color): void {}

        public function rect(int $x, int $y, int $w, int $h, int $color): void {}

        public function fillRect(int $x, int $y, int $w, int $h, int $color): void {}

        public function circle(int $cx, int $cy, int $r, int $color): void {}

        public function fillCircle(int $cx, int $cy, int $r, int $color): void {}

        /**
         * One line of text, ($x, $y) the top of the line; $bg null keeps what is under the text.
         *
         * @return int The width of the text in pixels.
         */
        public function text(int $x, int $y, string $s, int $color, ?int $bg = null, string $font = 'default'): int {}

        /**
         * Sends what was drawn since the last dirty() to the screen (at the next frame).
         */
        public function dirty(): void {}
    }

    /**
     * An image from a file: a .sli (converted by phpbm from the project's PNG assets: the fast path) or a .png
     * decoded on the board (needs png in slate-images). The image is loaded in the background as soon as the
     * Image is made or $src changes; until then the element draws nothing. Images are shared by path: Images of
     * the same file use one copy, loaded once; it stays in memory while an Image or a Preload holds it.
     *
     * $w, $h and $loaded change when ImageLoaded is delivered (or in wait()). A file that cannot be loaded raises
     * ImageFailed and the element stays empty.
     */
    final class Image extends Element
    {
        /**
         * The file: an absolute path ending in .sli or .png (in any case), e.g. '/app/assets/ui/bg.sli' for an
         * asset in flash or '/sdcard/assets/photos/beans.sli' for one on the microSD card. A new path loads that
         * image (at once when it is in memory already).
         */
        public string $src;

        /** The image's width in pixels; 0 until it is loaded (or when it failed). */
        public readonly int $w;

        /** The image's height in pixels; 0 until it is loaded (or when it failed). */
        public readonly int $h;

        /** true once the image is loaded. */
        public readonly bool $loaded;

        /**
         * @throws \RuntimeException When there is no memory even for the image's record ("Slate: no memory for the
         *     image <path>"), or when the table of ext-events' idle hooks is full ("Slate: cannot load images: the
         *     table of ext-events' idle hooks is full").
         * @throws \Exception In the web-server runtime (from ext-events: images raise events).
         * @throws \ValueError When $src is not an absolute path ("Baremetal\Slate\Image::$src must be an absolute
         *     path"), does not end in .sli or .png ("Baremetal\Slate\Image::$src must end in .sli or .png"), is a
         *     .png while png is not built ("png is not built in: add it to slate-images in composer.json"), or
         *     $opacity is out of 0..1.
         */
        public function __construct(int|float $x, int|float $y, string $src, float $opacity = 1.0) {}

        /**
         * Waits until the image is loaded, at most $timeout_ms milliseconds; no other event is delivered
         * meanwhile. $w, $h and $loaded are updated.
         *
         * @return bool true when the image is loaded; false on timeout or when it failed.
         * @throws \ValueError When $timeout_ms is negative.
         */
        public function wait(int $timeout_ms = 5000): bool {}
    }

    /**
     * Images loaded ahead of time: the next page's images, so that its Image elements are ready at once.
     */
    final class Images
    {
        private function __construct() {}

        /**
         * Starts loading every path (the ones in memory already are counted at once) and keeps the images in
         * memory while the returned Preload lives. PreloadProgress follows each image loaded, PreloadDone the
         * last one finished (also when every image was in memory already): exactly one per Preload.
         *
         * @param list<string> $paths Absolute paths ending in .sli or .png.
         * @throws \ValueError When a path is not absolute, does not end in .sli or .png, or is a .png while png is
         *     not built.
         * @throws \TypeError When an entry is not a string.
         * @throws \RuntimeException When there is no memory even for an image's record, or when the table of
         *     ext-events' idle hooks is full ("Slate: cannot load images: the table of ext-events' idle hooks is
         *     full").
         * @throws \Exception In the web-server runtime (from ext-events: images raise events).
         */
        public static function preload(array $paths): Preload {}
    }

    /**
     * The images of Images::preload(), held in memory while this object lives. Its properties change when the
     * events are delivered (or in wait()).
     */
    final class Preload
    {
        /** The images loaded so far. */
        public readonly int $loaded;

        /** The number of paths. */
        public readonly int $total;

        /** true when every image is loaded or failed. */
        public readonly bool $done;

        private function __construct() {}

        /**
         * Waits until no image is still loading, at most $timeout_ms milliseconds; no other event is delivered
         * meanwhile.
         *
         * @return bool true when every image is loaded; false on timeout or when one failed.
         * @throws \ValueError When $timeout_ms is negative.
         */
        public function wait(int $timeout_ms = 5000): bool {}
    }

    /**
     * An image finished loading (once per file, however many Image elements show it).
     */
    final class ImageLoaded extends \Baremetal\Event
    {
        /** The path, as given to Image or Images::preload(). */
        public readonly string $path;

        public readonly int $w;
        public readonly int $h;
    }

    /**
     * An image could not be loaded; the elements that show it stay empty. A later Image or $src of the same path
     * tries again.
     */
    final class ImageFailed extends \Baremetal\Event
    {
        public readonly string $path;
        public readonly ImageError $error;

        /** What went wrong, in words. */
        public readonly string $message;
    }

    /**
     * One more image of a Preload is loaded.
     */
    final class PreloadProgress extends \Baremetal\Event
    {
        /** Images of the Preload loaded so far. */
        public readonly int $loaded;

        public readonly int $total;
    }

    /**
     * Every image of a Preload is loaded or failed.
     */
    final class PreloadDone extends \Baremetal\Event
    {
        /** @var list<string> The paths that could not be loaded (empty when all were). */
        public readonly array $failed;
    }

    /**
     * An animation of Element::animate() or Tween::then(). The element is held while it runs.
     */
    final class Tween
    {
        /**
         * true once it ended by itself (after all its repeats); set when its TweenDone is delivered, or by wait().
         * Never for repeat -1; not after stop(), unless it ended in the very frame the stop reached the compositor.
         */
        public readonly bool $done;

        private function __construct() {}

        /**
         * Stops it, and the tweens chained after it with then(), without TweenDone. The properties stay where they
         * are on the screen (they still read the final values: write them to move them); with $toEnd they go to
         * their final values.
         *
         * @throws \RuntimeException When the compositor failed.
         */
        public function stop(bool $toEnd = false): void {}

        /**
         * Waits until it ends, at most $timeout_ms milliseconds; the pending changes are handed to the compositor
         * first, no event is delivered meanwhile. Returns false at once for a stopped tween and for repeat -1.
         *
         * @return bool true when it ended by itself.
         * @throws \ValueError When $timeout_ms is negative.
         */
        public function wait(int $timeout_ms = 5000): bool {}

        /**
         * A tween of $e that starts when this one ends (after the ones already chained after it), from the values
         * on the screen then; at once when this one has ended or stopped. stop() of the first stops the chain.
         *
         * @param array<string, int|float|null> $props As for Element::animate().
         * @throws \ValueError As Element::animate().
         */
        public function then(Element $e, array $props, int $ms = 300, Ease $ease = Ease::OutCubic): Tween {}
    }

    /**
     * A tween ended by itself (once per Tween; never for repeat -1; not after stop(), unless it ended in the very
     * frame the stop reached the compositor).
     */
    final class TweenDone extends \Baremetal\Event
    {
        public readonly Tween $tween;
    }

    /**
     * The easing curves of animations (the standard Penner curves). OutBack goes past the end and comes back,
     * OutBounce bounces at the end, OutElastic oscillates around it.
     */
    enum Ease
    {
        case Linear;
        case InQuad;
        case OutQuad;
        case InOutQuad;
        case InCubic;
        case OutCubic;
        case InOutCubic;
        case OutBack;
        case OutBounce;
        case OutElastic;
    }

    /**
     * How Slate::show() changes the scene: the old and the new one are composed together, band by band, for $ms
     * milliseconds along the $ease curve.
     */
    final class Transition
    {
        private function __construct() {}

        /**
         * The new scene appears over the old one, its opacity from 0 to 1.
         *
         * @throws \ValueError When $ms is below 1 (ms must be at least 1) or above 2147483647.
         */
        public static function fade(int $ms = 300, Ease $ease = Ease::OutCubic): Transition {}

        /**
         * The new scene comes in from the side opposite to $d and pushes the old one out towards $d.
         *
         * @throws \ValueError As fade().
         */
        public static function push(Direction $d, int $ms = 300, Ease $ease = Ease::OutCubic): Transition {}

        /**
         * The new scene slides in towards $d over the old one, which stays still.
         *
         * @throws \ValueError As fade().
         */
        public static function cover(Direction $d, int $ms = 300, Ease $ease = Ease::OutCubic): Transition {}

        /**
         * The old scene slides away towards $d and uncovers the new one, which stays still.
         *
         * @throws \ValueError As fade().
         */
        public static function uncover(Direction $d, int $ms = 300, Ease $ease = Ease::OutCubic): Transition {}
    }

    /**
     * The direction a transition moves in.
     */
    enum Direction
    {
        case Left;
        case Right;
        case Up;
        case Down;
    }

    /**
     * A transition of Slate::show() ended (also when a show() during it ended it): onLeave() of $from has run.
     * None for a transition from no scene (the first show()).
     */
    final class TransitionDone extends \Baremetal\Event
    {
        /** The scene left. */
        public readonly Scene $from;

        /** The scene shown. */
        public readonly Scene $to;
    }

    /**
     * Why an image could not be loaded.
     */
    enum ImageError: string
    {
        /** No such file. */
        case NotFound = 'not-found';

        /** The file could not be read. */
        case Unreadable = 'unreadable';

        /** Not a valid .sli or PNG: a damaged or truncated file, or another format under that name. */
        case BadFormat = 'bad-format';

        /** A valid PNG that is not decoded on the board (16 bits per channel, interlaced): convert it with phpbm. */
        case Unsupported = 'unsupported';

        /** Not enough memory for the image. */
        case NoMemory = 'no-memory';
    }

    /**
     * The ends of an Arc or a Line.
     */
    enum Caps: string
    {
        /** Square ends, at the end points. */
        case Butt = 'butt';

        /** Rounded ends, half a disc past the end points. */
        case Round = 'round';
    }

    /**
     * What a Text's x is: its left end, its centre or its right end.
     */
    enum Align: string
    {
        case Left = 'left';
        case Center = 'center';
        case Right = 'right';
    }

    /**
     * A gradient fill: LinearGradient or RadialGradient. Needs the gradients effect (slate-effects).
     */
    abstract class Gradient
    {
        /** The stops as given: [[position 0..1, color], ...] or [[position, color, alpha 0..1], ...]. */
        public readonly array $stops;
    }

    /**
     * A linear gradient across the element's box.
     */
    final class LinearGradient extends Gradient
    {
        /** Direction in degrees: 0 left to right, 90 top to bottom. */
        public readonly float $angle;

        /**
         * @param array $stops 2 to 16 stops [position 0..1, color 0xRRGGBB or 0xAARRGGBB] or [position, color,
         *     alpha 0.0..1.0] (the alpha replaces the color's: [1.0, 0xFFFFFF, 0.0] is transparent).
         * @throws \ValueError When the gradients effect is not built in, or a stop is wrong.
         */
        public function __construct(array $stops, float $angle = 0.0) {}
    }

    /**
     * A radial gradient: centre ($cx, $cy) and radius $r as fractions of the element's box.
     */
    final class RadialGradient extends Gradient
    {
        public readonly float $cx;
        public readonly float $cy;
        public readonly float $r;

        /**
         * @param array $stops 2 to 16 stops [position 0..1, color 0xRRGGBB or 0xAARRGGBB] or [position, color,
         *     alpha 0.0..1.0] (the alpha replaces the color's: [1.0, 0xFFFFFF, 0.0] is transparent).
         * @throws \ValueError When the gradients effect is not built in, or a value is wrong.
         */
        public function __construct(array $stops, float $cx = 0.5, float $cy = 0.5, float $r = 0.5) {}
    }

    /**
     * A drop shadow: offset ($dx, $dy), blur in pixels (how far the softness reaches, as in CSS) and color
     * (usually translucent, e.g. 0x80000000). Needs the shadows effect (slate-effects).
     */
    final class Shadow
    {
        public readonly int $dx;
        public readonly int $dy;
        public readonly int $blur;
        public readonly int|float $color;

        /**
         * @throws \ValueError When the shadows effect is not built in, or a value is out of range.
         */
        public function __construct(int $dx, int $dy, int $blur, int|float $color) {}
    }
}
